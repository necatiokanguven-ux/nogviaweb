<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files and directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Browser demo SPAs (Hostinger / Apache)
  RewriteRule ^demo/guest-guide/.+$ /demo/guest-guide/index.html [L]
  RewriteRule ^demo/finance/.+$ /demo/finance/index.html [L]
  RewriteRule ^demo/.+$ /demo/index.html [L]

  # Main site SPA fallback — React routes like /checkout/host-kit
  RewriteRule ^ index.html [L]
</IfModule>
