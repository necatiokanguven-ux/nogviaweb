# Web3Forms access key for the contact form on nogvia.com
VITE_WEB3FORMS_ACCESS_KEY="your-access-key-here"

# Supabase (Lite download leads + email OTP)
# Project URL: Dashboard → Settings → API → Project URL
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Use publishable key (sb_publishable_...) OR legacy anon key (eyJ...)
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
# VITE_SUPABASE_ANON_KEY="legacy-anon-key-if-needed"

# Optional fallback if Supabase is not configured yet
# VITE_LITE_OTP_API_URL="https://nogvia.com/api/lite"

# Optional: override Lemon Squeezy checkout URLs (defaults are set in src/constants/payment.ts)
# VITE_CHECKOUT_HOST_KIT="https://nogvia.lemonsqueezy.com/checkout/buy/87bdc5a1-0df4-4172-b510-f22df2e4909e"
# VITE_CHECKOUT_GUEST_GUIDE="https://nogvia.lemonsqueezy.com/checkout/buy/e05ff4be-e553-45b0-8ca8-70a76af447f1"
# VITE_CHECKOUT_FINANCE="https://nogvia.lemonsqueezy.com/checkout/buy/e9d7c7d6-6846-4598-8b51-455d7560d52e"
